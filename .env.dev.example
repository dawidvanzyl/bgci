# Settings of the dev profile. Copy to .env.dev and pass it to compose:
#   docker compose --env-file .env.dev --profile dev up --build -d
# The BGG values are needed for the API and the jobs service. Use a test account.
# Reserved, not published: 15201 api.
COMPOSE_PROJECT_NAME=bgci-dev
DEV_WEB_PORT=15200
DEV_DB_PORT=15202
DEV_JOBS_DASHBOARD_PORT=15203
DB_NAME=bgci
DB_USER=bgci
DB_PASSWORD=bgci
JOBS_DB_NAME=bgci_jobs
JOBS_DB_USER=bgci_jobs
JOBS_DB_PASSWORD=bgci_jobs
BGG_USERNAME=your-bgg-username
BGG_PASSWORD=your-bgg-password
BGG_BEARER_TOKEN=your-token-here
