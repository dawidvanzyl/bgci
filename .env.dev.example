# Settings of the dev profile. Copy to .env.dev and pass it to compose:
#   docker compose --env-file .env.dev --profile dev up --build -d
# The BGG values are needed for the writer and the API. Use a test account.
# Reserved, not published: 15201 api, 15203 writer.
COMPOSE_PROJECT_NAME=bgci-dev
DEV_WEB_PORT=15200
DEV_DB_PORT=15202
DB_NAME=bgci
DB_USER=bgci
DB_PASSWORD=bgci
BGG_USERNAME=your-bgg-username
BGG_PASSWORD=your-bgg-password
BGG_BEARER_TOKEN=your-token-here
