# Settings of the qa and dev profiles (docker compose --profile qa up, --profile dev up).
# Copy to .env to change them. Each parallel worktree needs its own port values so the stacks
# do not collide. The database values below are also the defaults, so no .env is required.
QA_WEB_PORT=3000
QA_MOCK_PORT=4010
DEV_DB_PORT=5433
DB_NAME=bgci
DB_USER=bgci
DB_PASSWORD=bgci
