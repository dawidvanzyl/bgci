DB_NAME=bgci
DB_USER=bgci
DB_PASSWORD=
JOBS_DB_NAME=bgci_jobs
JOBS_DB_USER=bgci_jobs
JOBS_DB_PASSWORD=
BGG_BEARER_TOKEN=
BGG_USERNAME=
# The jobs service signs in to BGG with this password to add and remove games in the BGG collection.
BGG_PASSWORD=
# Host port of the web UI. Change it if 15000 is in use.
BGCI_WEB_PORT=15000
# Host port of the jobs dashboard. It listens on 127.0.0.1 only. Change it if 15003 is in use.
BGCI_JOBS_DASHBOARD_PORT=15003
# Username of the BGG test account. It must be listed in test-data/bgg-live-test-accounts.json and must not be your own account. Used by the nightly live test.
BGG_TEST_USERNAME=
# Password of the BGG test account.
BGG_TEST_PASSWORD=
# Bearer token of the BGG test account. It may hold the same value as BGG_BEARER_TOKEN.
BGG_TEST_BEARER_TOKEN=
# Cron schedule of the nightly live test, in UTC.
BGG_LIVE_TEST_SCHEDULE=0 3 * * *
