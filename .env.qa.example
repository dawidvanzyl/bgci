# Settings of the qa profile. Copy to .env.qa and pass it to compose:
#   docker compose --env-file .env.qa --profile qa up --build -d
# Every value has a default, so .env.qa is optional. Each parallel worktree needs its own port
# values so the stacks do not collide.
# Reserved, not published: 15101 api, 15102 db.
COMPOSE_PROJECT_NAME=bgci-qa
QA_WEB_PORT=15100
QA_MOCK_PORT=15103
DB_NAME=bgci
DB_USER=bgci
DB_PASSWORD=bgci
